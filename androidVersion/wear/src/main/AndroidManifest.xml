<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.type.watch" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:label="SOUND"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@style/SoundWear">
        <!-- Telefondaki SOUND'u kumanda eder; telefon olmadan çalmaz -->
        <meta-data android:name="com.google.android.wearable.standalone" android:value="false" />

        <activity android:name=".NowActivity" android:exported="true" android:taskAffinity="" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".LibraryActivity" android:exported="false" />

        <!-- telefonda şarkı değişince kart güncellensin -->
        <service android:name=".DataService" android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/sound" />
            </intent-filter>
        </service>

        <!-- kaydırınca açılan kart: çalan şarkı ve düğmeler -->
        <service android:name=".NowTile" android:exported="true" android:label="SOUND"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data android:name="androidx.wear.tiles.PREVIEW" android:resource="@mipmap/ic_launcher" />
        </service>
    </application>
</manifest>
